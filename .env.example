# Required: from the NxtFireGuard dashboard.
TRAFFIC_SENSOR_NAME=
AUTH_SECRET=
HEARTBEAT_IDENTIFIER=

# Syslog listener (UDP and TCP). Pick a port other than 514 and 1025-1028
# if the Threat Feed Aggregator runs on the same host.
SYSLOG_LISTEN_ADDR=0.0.0.0
SYSLOG_PORT=514

# Optional.
# DEBUG=false
# SQLITE_DB_PATH=/data/ip_scores.db
# NFG_ARBITER_URL=https://arbiter.nxtfireguard.de
# NFG_ARBITER_HOST=                  # websocket host, if it differs from NFG_ARBITER_URL
# STREAMING_SKIP_VERIFY_TLS=false    # skip TLS verification (test backends only)
# HEARTBEAT_URL=https://heartbeat.nxtfireguard.de
# IP_SCORE_CACHE_SIZE=10000
# RECOMMENDATIONS_CACHE_SIZE=10000
# EVALUATION_WORKERS=8
# EVALUATION_QUEUE_SIZE=4096
